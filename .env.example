# =============================================================================
# 公開設定 — ECS タスク定義の environment に平文で渡す
# =============================================================================
NODE_ENV=development
PORT=3003
DATABASE_SSL=false
TYPEORM_LOGGING=true
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=${APP_NAME}-dev
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://backend:3003/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:3003/api/v1
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=

# =============================================================================
# インフラ設定 — ローカル開発専用（本番は RDS / LocalStack が自動生成）
# =============================================================================
# AWS アカウント ID（CDK synthesis time にのみ使用。ECS には渡さない）
DEV_AWS_ACCOUNT_ID=
PROD_AWS_ACCOUNT_ID=

# アプリ名（S3バケット名・ECSリソース名などのベース名。CDKが ${APP_NAME}-{env} 等を導出）
APP_NAME=credit-checker

# Postgres（docker compose でのみ使用）
POSTGRES_USER=credit_checker
POSTGRES_PASSWORD=password
POSTGRES_DB=credit_checker_db

# LocalStack（ローカル開発時のみ。本番環境では未設定にすることで AWS 本番エンドポイントを使用）
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localstack:4566

# =============================================================================
# Strong Secret — Secrets Manager に登録 / ローカルは secrets/ ファイルで管理
# ECS本番: タスク定義の secrets: フィールド経由で環境変数として注入（タスク定義に平文は残らない）
# ローカル: docker compose secrets でファイルマウント（/run/secrets/<name>）
# =============================================================================
# セットアップ手順:
#   mkdir -p secrets
#   echo "postgresql://..." > secrets/database_url
#   echo "your-jwt-secret"  > secrets/jwt_secret
#   echo "your-auth-secret" > secrets/auth_secret
#   echo "your-google-secret" > secrets/auth_google_secret
#   echo "your-openai-key"  > secrets/openai_api_key
#
# secrets/database_url       → /run/secrets/database_url
# secrets/jwt_secret         → /run/secrets/jwt_secret
# secrets/auth_secret        → /run/secrets/auth_secret
# secrets/auth_google_secret → /run/secrets/auth_google_secret
# secrets/openai_api_key     → /run/secrets/openai_api_key


# =============================================================================
# GitHub Actions — リポジトリの Settings > Secrets and variables に登録
# ここに実際の値は書かない（.env はローカル専用）
# =============================================================================
# [Secrets] Settings > Secrets and variables > Actions > Repository secrets
#   DEV_AWS_ACCOUNT_ID   = AWSアカウントID（dev環境）
#   PROD_AWS_ACCOUNT_ID  = AWSアカウントID（prod環境）
#
# [Variables] Settings > Secrets and variables > Actions > Repository variables
#   AWS_REGION           = ap-northeast-1
#   AUTH_GOOGLE_ID       = Google OAuth クライアントID（公開設定のためVariablesで管理）
#   APP_NAME             = credit-checker（S3バケット名・ECSリソース名などのベース名。CDKが ${APP_NAME}-{env} 等を導出）
