# =============================================================================
# 公開設定 — ECS タスク定義の environment に平文で渡す
# =============================================================================
NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=3003
DATABASE_SSL=false
TYPEORM_LOGGING=true
AWS_REGION=ap-northeast-1
# S3_BUCKET_NAME: ${APP_NAME}-dev を推奨。CDKが本番では ${APP_NAME}-${env} で導出する
S3_BUCKET_NAME=myapp-dev
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://backend:3003/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:3003/api/v1
# NEXT_PUBLIC_BASE_PATH: アプリを配置するパス。ルートに置く場合は空文字。CloudFront配下に置く場合は /<app-name>
NEXT_PUBLIC_BASE_PATH=/myapp
# AUTH_URL: ${FRONTEND_URL}${NEXT_PUBLIC_BASE_PATH}/api/auth の形式で設定する
AUTH_URL=http://localhost:3000/myapp/api/auth
# SERVER_ACTIONS_ALLOWED_ORIGINS: 本番ドメインをカンマ区切りで列挙。ローカルは空で可
SERVER_ACTIONS_ALLOWED_ORIGINS=
AUTH_GOOGLE_ID=

# Postgres（docker compose でのみ使用）
POSTGRES_USER=app_user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db

# LocalStack（ローカル開発時のみ。本番環境では未設定にすることで AWS 本番エンドポイントを使用）
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localstack:4566

# =============================================================================
# Strong Secret — Secrets Manager に登録 / ローカルは secrets/ ファイルで管理
# ECS本番: タスク定義の secrets: フィールド経由で環境変数として注入（タスク定義に平文は残らない）
# ローカル: ./setup.sh を実行すると secrets/ ファイルを自動生成する
#   JWT_SECRET / AUTH_SECRET は未設定なら openssl で自動生成
#   DATABASE_URL は POSTGRES_* 変数から自動組み立て
#   AUTH_GOOGLE_SECRET / OPENAI_API_KEY は外部サービスの値を要設定
# =============================================================================
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
JWT_SECRET=
OPENAI_API_KEY=


# =============================================================================
# GitHub Actions — リポジトリの Settings > Secrets and variables に登録
# ここに実際の値は書かない（.env はローカル専用）
# =============================================================================
# [Secrets] Settings > Secrets and variables > Actions > Repository secrets
#   DEV_AWS_ACCOUNT_ID   = AWSアカウントID（dev環境）
#   PROD_AWS_ACCOUNT_ID  = AWSアカウントID（prod環境）
#
# [Variables] Settings > Secrets and variables > Actions > Repository variables
#   AWS_REGION           = ap-northeast-1
#   AUTH_GOOGLE_ID       = Google OAuth クライアントID（公開設定のためVariablesで管理）
#   APP_NAME             = credit-checker（S3バケット名・ECSリソース名などのベース名。CDKが ${APP_NAME}-{env} 等を導出）
