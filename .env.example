# === 公開してよい設定（ECS environment に平文で渡す） ===
NODE_ENV=
AWS_REGION=
S3_BUCKET_NAME=
FRONTEND_URL=
BACKEND_URL=
NEXT_PUBLIC_BACKEND_URL=
AUTH_URL=
AUTH_GOOGLE_ID=

# Postgres（ローカル開発専用）
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# LocalStack（ローカル開発専用）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# === 強い secret（Secrets Manager に登録 / ローカルは secrets/ ファイル） ===
# 以下は secrets/ 配下のファイルとして管理する（.gitignore 対象）
# セットアップ手順:
#   mkdir -p secrets
#   echo "postgresql://..." > secrets/database_url
#   echo "your-jwt-secret" > secrets/jwt_secret
#   echo "your-auth-secret" > secrets/auth_secret
#   echo "your-google-secret" > secrets/auth_google_secret
#   echo "your-openai-key" > secrets/openai_api_key
#
# secrets/database_url       → DATABASE_URL
# secrets/jwt_secret         → JWT_SECRET
# secrets/auth_secret        → AUTH_SECRET
# secrets/auth_google_secret → AUTH_GOOGLE_SECRET
# secrets/openai_api_key     → OPENAI_API_KEY
