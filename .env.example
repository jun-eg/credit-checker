POSTGRES_USER=credit_checker
POSTGRES_PASSWORD=password
POSTGRES_DB=credit_checker_db
DATABASE_URL=postgresql://credit_checker:password@localhost:5433/credit_checker_db

# NestJS
JWT_SECRET=your-jwt-secret-here

# NextAuth.js
AUTH_SECRET=your-auth-secret-here
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# フロントエンドからバックエンドへのURL
BACKEND_URL=http://localhost:3003
NEXT_PUBLIC_BACKEND_URL=http://localhost:3003
# バックエンドのCORS許可オリジン
FRONTEND_URL=http://localhost:3000

# AWS S3 / LocalStack
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=credit-checker-receipts
# ローカル開発時のみLocalStackのエンドポイントを指定。本番環境では未設定にすることでAWS本番エンドポイントを使用する
S3_ENDPOINT=http://localhost:4566
