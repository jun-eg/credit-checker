{
  "name": "credit-checker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "make up",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "install": "npm install --prefix apps/frontend && npm install --prefix apps/backend",
    "lint": "npm run lint --prefix apps/frontend && npm run lint --prefix apps/backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "@nestjs/schedule": "^6.1.1"
  }
}
